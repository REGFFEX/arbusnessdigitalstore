generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model admins {
  id                 String               @id @db.Uuid
  external_id        String?              @unique
  email              String?              @unique
  role               String?              @default("admin")
  status             String?              @default("active")
  display_name       String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  avatar_url         String?
  permissions        Json?                @default("{}")
  phone              String?
  whatsapp           String?
  github             String?
  facebook           String?
  tiktok             String?
  qr_code_url        String?
  ardes_system_state ardes_system_state[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ads {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  video_url    String?
  position     String?
  active       Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  priority     Int?      @default(0)
  revenue_type String?   @default("internal")
  type         String?   @default("video")
  media_url    String?
  target_url   String?
  is_published Boolean?  @default(false)
  source_id    String?   @db.Uuid
  ads          ads?      @relation("adsToads", fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_ads    ads[]     @relation("adsToads")

  @@index([position], map: "idx_ads_position")
  @@schema("public")
}

model categories {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String     @unique
  products products[]
  subtypes subtypes[]

  @@schema("public")
}

model download_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String?   @db.Uuid
  user_id    String?   @db.Uuid
  ip         String?   @db.Inet
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  user_agent String?
  ip_address String?
  products   products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  short_desc             String?
  description            String?
  type                   String?
  category_id            String?             @db.Uuid
  license                String?
  os                     String?
  version                String?
  size                   String?
  image                  String?
  image_path             String?
  file_url               String?
  file_path              String?
  status                 String?
  tags                   String[]            @default([])
  created_at             DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?           @default(now()) @db.Timestamptz(6)
  screenshots            String[]            @default([])
  is_premium             Boolean?            @default(false)
  monetization_type      String?             @default("free")
  price                  Decimal?            @db.Decimal(10, 2)
  contributors           Json?               @default("[]")
  placements             String[]            @default(["new"])
  is_project             Boolean?            @default(false)
  project_phase          String?             @default("announcement")
  estimated_date         String?
  roadmap                Json?               @default("[]")
  access_type            String?             @default("direct")
  price_fcfa             Int?                @default(0)
  multi_types            String[]            @default([])
  active                 Boolean?            @default(true)
  source                 String?             @default("AR BUSINESS") @db.VarChar(50)
  versions               Json?               @default("[]")
  category               String?             @default("Général") @db.VarChar(100)
  sub_type               String?             @default("Général")
  is_published           Boolean?            @default(false)
  source_id              String?             @db.Uuid
  formation_domain       String?
  formation_level        String?             @default("debutant")
  formation_certificate  String?             @default("none")
  formation_monetization String?
  game_genre             String?
  partner_name           String?
  partner_link           String?
  partner_qr_url         String?
  relations              Json?               @default("[]")
  edition                String?
  ranking_position       Int?                @default(0)
  custom_source_suffix   String?
  price_eur              Decimal?            @default(0) @db.Decimal
  ads_video_count        Int?                @default(0)
  ads_video_price        Decimal?            @default(0) @db.Decimal
  display_config         Json?               @default("{\"show_eur\": true, \"show_usd\": true, \"show_fcfa\": true}")
  file_name_override     String?
  requires_license       Boolean?            @default(false)
  center_posts           center_posts[]
  download_logs          download_logs[]
  download_tokens        download_tokens[]
  categories             categories?         @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  products               products?           @relation("productsToproducts", fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_products         products[]          @relation("productsToproducts")
  training_modules       training_modules[]
  training_progress      training_progress[]

  @@index([created_at], map: "idx_products_created_at")
  @@index([placements], map: "idx_products_placements", type: Gin)
  @@index([category_id], map: "idx_products_cat")
  @@index([type], map: "idx_products_type")
  @@index([edition], map: "idx_products_edition")
  @@index([ranking_position], map: "idx_products_ranking_position")
  @@schema("public")
}

model training_modules {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String              @db.Uuid
  name              String
  type              String?             @default("video")
  file_url          String?
  file_path         String?
  order             Int                 @default(0)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  order_index       Int?                @default(0)
  products          products            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  training_progress training_progress[]

  @@index([order_index], map: "idx_training_modules_order")
  @@index([product_id], map: "idx_training_modules_product_id")
  @@schema("public")
}

model system_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String?
  action     String?
  user       String?
  timestamp  DateTime? @default(now()) @db.Timestamptz(6)
  user_email String?
  details    Json?     @default("{}")

  @@index([timestamp(sort: Desc)], map: "idx_system_logs_timestamp")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model services {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  description          String?
  type                 String?
  image                String?
  active               Boolean?       @default(true)
  created_at           DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?      @default(now()) @db.Timestamptz(6)
  placements           String[]       @default(["new"])
  is_project           Boolean?       @default(false)
  project_phase        String?        @default("announcement")
  estimated_date       String?
  roadmap              Json?          @default("[]")
  source               String?        @default("AR BUSINESS") @db.VarChar(50)
  contact_manager      String?
  whatsapp_link        String?
  telegram_link        String?
  external_link        String?
  features             Json?          @default("[]")
  long_description     String?
  category             String?        @default("Général") @db.VarChar(100)
  sub_type             String?        @default("Général")
  monetization_type    String?        @default("premium")
  is_premium           Boolean?       @default(false)
  is_published         Boolean?       @default(false)
  source_id            String?        @db.Uuid
  custom_source_suffix String?
  price_eur            Decimal?       @default(0) @db.Decimal
  ads_video_count      Int?           @default(0)
  ads_video_price      Decimal?       @default(0) @db.Decimal
  display_config       Json?          @default("{\"show_eur\": true, \"show_usd\": true, \"show_fcfa\": true}")
  requires_license     Boolean?       @default(false)
  center_posts         center_posts[]
  services             services?      @relation("servicesToservices", fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_services       services[]     @relation("servicesToservices")

  @@index([active], map: "idx_services_active")
  @@index([created_at(sort: Desc)], map: "idx_services_created_at")
  @@index([placements], map: "idx_services_placements", type: Gin)
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model site_settings {
  id                   String    @id @default("current")
  site_name            String?   @default("AR BUSINESS DIGITAL STORE")
  site_slogan          String?   @default("Votre partenaire digital de confiance")
  logo_url             String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
  ribbon_enabled       Boolean?  @default(true)
  ribbon_targets       Json?     @default("[\"/\", \"/store\", \"/categories\", \"/services\", \"/community\"]")
  site_content         Json?     @default("{\"home\": {\"hero\": {\"title\": \"Découvrez le futur du digital\", \"subtitle\": \"Votre partenaire digital au Congo\"}}, \"services\": {\"header\": {\"title\": \"NOS SERVICES\", \"subtitle\": \"Solutions B2B personnalisées\"}}, \"community\": {\"header\": {\"title\": \"AR Business Community\", \"subtitle\": \"Rejoignez le mouvement Digital Store\"}}}")
  maintenance_mode     Boolean?  @default(false)
  section_visibility   Json?     @default("{\"home_cta\": true, \"home_hero\": true, \"global_ads\": true, \"global_search\": true, \"global_social\": true, \"home_sections\": true, \"footer_sitemap\": true, \"home_categories\": true}")
  logo_border_radius   String?   @default("16px")
  ribbon_text_desktop  String?   @default("BIENVENUE SUR AR BUSINESS DIGITAL STORE — VOTRE PARTENAIRE EN AFRIQUE")
  ribbon_text_mobile   String?   @default("AR BUSINESS STORE — PARTENAIRE DIGITAL")
  logo_targets         Json?     @default("{\"auth\": true, \"footer\": true, \"navbar\": true, \"ribbon\": false}")
  store_titles         Json?     @default("{\"hero_title\": \"Découvrez le futur du digital\", \"services_title\": \"Nos Services AR\", \"community_title\": \"Communauté AR Business\"}")
  custom_css           String?   @default("")
  footer_copyright     String?   @default("© 2026 AR Business Digital Store. Tous droits réservés.")
  auth_welcome_text    String?   @default("Bienvenue sur votre espace sécurisé.")
  last_pushed_at       DateTime? @db.Timestamptz(6)
  branding_name        String?   @default("AR BUSINESS DIGITAL STORE")
  branding_description String?   @default("Pôle de AR BUSINESS spécialisé dans la distribution et la vente de produits et services digitaux.")
  branding_location    String?   @default("Afrique, Congo-Brazzaville, Académie Militaire Marien NGOUABI")
  branding_autoscroll  Boolean?  @default(true)
  logo_center_url      String?

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model community_posts {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  content        String
  media_url      String?
  media_type     String?
  external_links Json?     @default("[]")
  author_id      String?   @db.Uuid
  is_pinned      Boolean?  @default(false)
  view_count     Int?      @default(0)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  theme          String?   @default("glass")
  metadata       Json?     @default("{}")
  status         String?   @default("active")
  deleted_at     DateTime? @db.Timestamptz(6)
  updated_at     DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payment_settings {
  id                  String    @id @default("current")
  mtn_number          String?   @default("")
  airtel_number       String?   @default("")
  orange_number       String?   @default("")
  paypal_email        String?   @default("")
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  payment_instruction String?   @default("Redirection vers la plateforme sécurisée de paiement.")
  mtn_checkout_url    String?
  airtel_checkout_url String?
  orange_checkout_url String?

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model training_progress {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String            @db.Uuid
  product_id       String?           @db.Uuid
  module_id        String?           @db.Uuid
  is_completed     Boolean?          @default(false)
  last_position    Int?              @default(0)
  completed_at     DateTime?         @db.Timestamptz(6)
  updated_at       DateTime?         @default(now()) @db.Timestamptz(6)
  training_modules training_modules? @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         products?         @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, module_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ardes_system_state {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  maintenance_mode Boolean?  @default(false)
  last_sync_at     DateTime? @db.Timestamptz(6)
  last_sync_by     String?   @db.Uuid
  sync_log         String?
  created_at       DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  admins           admins?   @relation(fields: [last_sync_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model download_tokens {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token      String    @unique
  product_id String?   @db.Uuid
  file_path  String
  bucket     String?   @default("files")
  created_at DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  products   products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_download_tokens_product_id")
  @@index([token], map: "idx_download_tokens_token")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subtypes {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id String?     @db.Uuid
  name        String
  slug        String
  created_at  DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  categories  categories? @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([category_id, name])
  @@schema("public")
}

model branding_messages {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  content    String
  active     Boolean?  @default(true)
  file_url   String?
  created_at DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model center_posts {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              String    @default("announcement")
  title             String
  content           String?
  media_urls        Json?     @default("[]")
  thumbnail         String?
  linked_product_id String?   @db.Uuid
  linked_service_id String?   @db.Uuid
  external_url      String?
  priority          String    @default("normal")
  status            String    @default("draft")
  source            String    @default("AR_BUSINESS")
  source_detail     String?
  admin_id          String?   @db.Uuid
  card_size         String    @default("md")
  pinned            Boolean?  @default(false)
  share_count       Int?      @default(0)
  scheduled_at      DateTime? @db.Timestamptz(6)
  expires_at        DateTime? @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  block_id          String?   @db.Uuid
  block_order       Int?      @default(0)
  layout_config     Json?     @default("{}")
  products          products? @relation(fields: [linked_product_id], references: [id], onUpdate: NoAction)
  services          services? @relation(fields: [linked_service_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_center_posts_created")
  @@index([priority], map: "idx_center_posts_priority")
  @@index([status], map: "idx_center_posts_status")
  @@index([type], map: "idx_center_posts_type")
  @@schema("public")
}
