generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  shortDesc   String
  description String
  type        String
  category    String
  license     String
  os          String
  version     String
  size        String
  image       String
  fileUrl     String
  status      String
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ad {
  id       String   @id @default(uuid())
  title    String
  videoUrl String
  position String
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
}

model SystemLog {
  id        String   @id @default(uuid())
  type      String
  action    String
  user      String?
  timestamp DateTime @default(now())
}
